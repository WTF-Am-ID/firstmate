FM_TEST_BEGIN 2026-10-28T15:46:02Z tests/fm-timeout-lib.test.sh family=pure-contract-unit expected_gate_skip=none
ok - fm_run_timed perl reaps owned groups and preserves caller signal dispositions on INT/HUP/TERM and timeout
[1]+  Interrupt: 2            perl -MPOSIX=WNOHANG,setpgid -MTime::HiRes=time -e '
        my $bound = shift;
        my ($signal, $kill_at, $result) = (0, 0, 0);
        for my $entry ([HUP => 1], [INT => 2], [TERM => 15]) {
          my ($name, $number) = @$entry;
          $SIG{$name} = sub { $signal ||= $number };
        }
        my $pid = fork;
        exit 127 unless defined $pid;
        if (!$pid) {
          $SIG{$_} = "DEFAULT" for qw(INT HUP TERM);
          setpgid(0, 0);
          exec @ARGV;
          exit 127;
        }
        # Both sides establish the group before the parent can signal it.
        setpgid($pid, $pid);
        my $deadline = time + $bound;
        while (1) {
          if (!$kill_at && ($signal || time >= $deadline)) {
            $result = $signal ? 128 + $signal : 124;
            $kill_at = time + 0.2;
            kill "TERM", -$pid;
          }
          my $done = waitpid $pid, WNOHANG;
          if ($done == $pid) {
            my $status = $?;
            kill "KILL", -$pid if $kill_at;
            exit($kill_at ? $result : ($status & 127) ? 128 + ($status & 127) : $status >> 8);
          }
          exit 127 if $done == -1;
          if ($kill_at && time >= $kill_at) {
            kill "KILL", -$pid;
            waitpid $pid, 0;
            exit $result;
          }
          select undef, undef, undef, 0.02;
        }
      ' -- "$seconds" "$@" 0<&0
