    "exit": 1,
    "output": "error: watching a GitLab merge request requires glab on PATH\n"
  },
  {
    "command": [
      "bash",
      "bin/fm-pr-check.sh",
      "base-unreadable",
      "https://gerrit.invalid/c/project/+/1"
