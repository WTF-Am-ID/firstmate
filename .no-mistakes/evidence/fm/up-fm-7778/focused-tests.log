            printf "{\"session_id\":\"sess-host-hook\",\"stop_hook_active\":false}\n" \
              | "$FM_HOME/bin/fm-claude-stop-autoarm.sh" > "$FM_HOME/hook.out" 2> "$FM_HOME/hook.err"
            printf "%s\n" "$?" > "$FM_HOME/hook.rc"
          fi
        fi
        sleep 0.1
      done
